# ==========================================
# GRAFANA
# ==========================================
GF_SECURITY_ADMIN_PASSWORD=admin

# ==========================================
# MYSQL
# ==========================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=kale_db
MYSQL_USER=kale_user
MYSQL_PASSWORD=kale_password

# ==========================================
# MYSQL EXPORTER
# ==========================================
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=exporter_password

# ==========================================
# REDIS
# ==========================================
# Docker Compose servis adı (redis) ile aynı olmalı
REDIS_HOST=redis
REDIS_PORT=6379
# Güvenlik için gerçek şifrenizi buraya yazmayın
REDIS_PASSWORD=your_redis_password_here

# ==========================================
# KALE APP (Uygulama Ayarları)
# ==========================================
# Alarm/hata testleri (/test/error, /test/slow) için: development
# Canlı (prod) sunucuda: production
NODE_ENV=development
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_USER=kale_user
DB_PASSWORD=kale_password
DB_NAME=kale_db

# ==========================================
# İLK KURULUM ADMİN BİLGİLERİ (Knex Seed İçin)
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=temporary_admin_password_123
ADMIN_FULL_NAME=Sistem Yoneticisi
